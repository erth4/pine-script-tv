//@version=6
indicator("Elliott Wave Auto Count", shorttitle = "EW Auto", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 50, max_bars_back = 200)

// ───────── Input ─────────
grpZ = "Zigzag"
thrMode  = input.string("Auto", "Mode threshold", options = ["Auto", "Persen", "ATR"], group = grpZ,
     tooltip = "Auto: M 30%, W 15%, D 6%, 4h 2.5%, 1h 1.2%, 15m 0.6%, di bawahnya 0.3%. Disetel dari pengujian BTC. Untuk aset lain pakai Persen atau ATR.")
thrPctIn = input.float(5.0, "Threshold persen (%)", minval = 0.05, step = 0.05, group = grpZ)
atrLen   = input.int(14, "Panjang ATR", minval = 1, group = grpZ)
atrMult  = input.float(3.0, "Pengali ATR", minval = 0.1, step = 0.1, group = grpZ)

grpC = "Penghitungan"
winK      = input.int(20, "Jumlah pivot yang dianalisis", minval = 6, maxval = 40, group = grpC,
     tooltip = "Semakin besar, semakin jauh ke belakang pencarian anchor gelombang 0, tapi kalkulasi lebih berat.")
allowDiag = input.bool(true, "Izinkan diagonal (overlap W4–W1)", group = grpC,
     tooltip = "Overlap hanya diterima jika bentuknya menyempit: W3 < W1, W4 < W2, dan W5 < W3.")
showAlt   = input.bool(true, "Tampilkan hitungan alternatif", group = grpC)
useHtf    = input.bool(true, "Bias arah swing timeframe lebih tinggi", group = grpC,
     tooltip = "HTF otomatis satu tingkat di atas chart (1h→4h, 4h→D, D→W, W→M). Hitungan yang searah swing HTF diberi skor lebih tinggi.")
useLog    = input.bool(true, "Hitung rasio di skala log (persen)", group = grpC,
     tooltip = "Rasio Fibonacci, aturan, target, dan proyeksi dihitung dari perubahan persen, bukan selisih harga. Disarankan untuk crypto/aset yang bergerak ratusan persen; tanpa ini target turun bisa terlalu dalam (mis. C = A di 18rb, versi log ~40rb).")
projTol   = input.float(3.0, "Toleransi konfluens proyeksi (%)", minval = 0.5, step = 0.5, group = grpC,
     tooltip = "Rasio proyeksi yang berjarak sedekat ini dengan level penting lain (retrace impuls, ujung W4, 0.618×(0–3)) diprioritaskan.")
confTol   = input.float(1.0, "Toleransi konfluens (%)", minval = 0.1, step = 0.1, group = grpC,
     tooltip = "Target utama yang berjarak sedekat ini dengan level hitungan alternatif ditandai ★.")

grpM = "Momentum & konfirmasi"
showMom  = input.bool(true, "Info divergensi RSI & momentum W3", group = grpM,
     tooltip = "Hanya informasi, tidak memengaruhi skor. Uji walk-forward (7.189 pembalikan) tidak menemukan keunggulan dari divergensi.")
rsiLen   = input.int(14, "Panjang RSI", minval = 2, group = grpM)
showConf = input.bool(true, "Level konfirmasi akhir gelombang", group = grpM,
     tooltip = "Level di mana zigzag berbalik, artinya gelombang yang sedang berjalan dianggap selesai dan hitungan bergeser.")

provFrac = input.float(0.5, "Pivot sementara (× threshold)", minval = 0, maxval = 1, step = 0.1, group = grpM,
     tooltip = "Bila harga sudah berbalik sejauh ini dari ekstrem terakhir tetapi zigzag belum berbalik penuh, ekstrem berlawanan dipakai sebagai pivot sementara. Mencegah TF besar (mis. Monthly 30%) tertinggal jauh dari harga. 0 = mati.")

grpS = "Support/Resistance & price action"
showSR    = input.bool(true, "Zona support/resistance", group = grpS,
     tooltip = "Zona dari pivot zigzag terkonfirmasi, dibagi Major dan Minor. Ditampilkan zona terdekat di atas & di bawah harga, plus zona Major terdekat bila tidak termasuk di situ. ★EW = berimpit dengan target/level batal Elliott.")
srPerSide = input.int(2, "Jumlah zona per sisi", minval = 1, maxval = 5, group = grpS)
srWidth   = input.float(1.0, "Lebar zona (× ATR)", minval = 0.2, step = 0.1, group = grpS)
srMinT    = input.int(2, "Minimal sentuhan (Minor)", minval = 1, maxval = 6, group = grpS,
     tooltip = "Zona Minor baru ditampilkan setelah disentuh sebanyak ini. Zona Major tetap ditampilkan walau baru 1 sentuhan.")
srMajMult = input.float(2.0, "Major: swing pivot ≥ × threshold", minval = 1.0, step = 0.25, group = grpS,
     tooltip = "Zona Major bila salah satu pivotnya adalah swing besar: kedua leg di kiri & kanan pivot ≥ pengali ini × threshold zigzag (mis. 1W 15% × 2 = 30%). Pivot seperti ini adalah titik balik derajat lebih tinggi. Default 2 ≈ rasio threshold Auto antar-TF (M/W, D/4h, 1h/15m = 2–2.5); 2.5 sudah membuat ATH di Monthly jadi Minor.")
srMajT    = input.int(5, "Major: minimal sentuhan", minval = 2, maxval = 10, group = grpS,
     tooltip = "Zona juga Major bila disentuh sebanyak ini, walau swing-nya kecil. Default 5: zona selebar 1 ATR mudah mengumpulkan 3–4 pivot, sehingga dengan 3 hampir semua zona (mis. di 15m) jadi Major.")
showPA    = input.bool(true, "Price action di zona/level Elliott", group = grpS,
     tooltip = "Engulfing & pin bar hanya ditandai bila terjadi di zona S/R atau dekat target/level batal Elliott.")
paBars    = input.int(10, "Bar terakhir yang dipindai PA", minval = 1, maxval = 100, group = grpS)

showMS  = input.bool(true, "BOS / CHoCH (market structure)", group = grpS,
     tooltip = "Dari pivot zigzag indikator ini. BOS = tembus swing searah tren struktur; CHoCH (≈ MSS) = tembus pertama melawan tren.")
msMax   = input.int(60, "Maks BOS/CHoCH historis", minval = 1, maxval = 150, group = grpS,
     tooltip = "BOS/CHoCH ditampilkan di seluruh rentang pivot historis (lihat grup Historis), dari yang terbaru, dibatasi jumlah ini.")
showSwAll = input.bool(false, "Semua sweep likuiditas", group = grpS,
     tooltip = "Default mati: sweep saja tidak punya keunggulan (uji EV ≈ 0R). Sweep yang diikuti CHoCH searah selalu ditampilkan (tanda ⚡).")
showOB  = input.bool(true, "Order block supply/demand", group = grpS,
     tooltip = "Hanya OB terdekat yang belum tersentuh. Uji: retest OB tidak berbeda dari zona acak di leg yang sama.")
obCount = input.int(1, "OB per sisi", minval = 1, maxval = 5, group = grpS)

showFVG   = input.bool(true, "Fair value gap (FVG)", group = grpS,
     tooltip = "Hanya FVG ≥ ukuran minimal yang belum tersentuh, terdekat di atas & di bawah harga. Uji: FVG ≥ 0.5 ATR dihormati lebih baik dari zona acak (EV +0.02R vs −0.18R di target 2R), tapi sendirian hanya impas.")
fvgMinAtr = input.float(0.5, "Ukuran minimal FVG (× ATR)", minval = 0, step = 0.1, group = grpS)
fvgCount  = input.int(1, "FVG per sisi", minval = 1, maxval = 5, group = grpS)

grpH = "Historis"
showHist     = input.bool(true, "Label pola historis", group = grpH)
histPivots   = input.int(120, "Jumlah pivot historis", minval = 20, maxval = 400, group = grpH,
     tooltip = "Seberapa jauh ke belakang pola lengkap dicari. Lebih besar = lebih berat dihitung.")
histWin      = input.int(20, "Jendela pivot per pola", minval = 8, maxval = 40, group = grpH,
     tooltip = "Batas jumlah pivot yang boleh dicakup satu pola historis. Naikkan kalau pola besar tidak terdeteksi.")
histMinScore = input.float(0.45, "Skor minimum pola historis", minval = 0, maxval = 1, step = 0.05, group = grpH)

grpV = "Tampilan"
showTargets = input.bool(true, "Tampilkan target & level batal", group = grpV)
showPassed  = input.bool(false, "Tampilkan target yang sudah terlewati (✓)", group = grpV)
projLegs    = input.int(3, "Jumlah gelombang proyeksi", minval = 0, maxval = 6, group = grpV,
     tooltip = "Jalur putus-putus ke masa depan, termasuk gelombang yang sedang berjalan. 0 = mati. Harga dari rasio Fibonacci standar, waktu dari durasi gelombang sebanding (W3≈W1, W4≈W2, W5≈W1, B≈A, C≈A).")
showZz      = input.bool(false, "Tampilkan zigzag mentah", group = grpV)
tblCompact  = input.bool(true, "Tabel ringkas", group = grpV,
     tooltip = "Hanya hitungan utama, level batal, dan alternatif. Info HTF, momentum, dan S/R pindah ke tooltip baris pertama.")
tblPosIn    = input.string("Kiri bawah", "Posisi tabel", options = ["Kanan atas", "Kanan bawah", "Kiri atas", "Kiri bawah"], group = grpV)
lblGap      = input.float(3.0, "Jarak minimal label (% tinggi chart)", minval = 0.5, step = 0.5, group = grpV,
     tooltip = "Tinggi satu baris label sebagai persen rentang harga di layar. Label level di kanan yang lebih rapat dari ini digeser ke atas (garis levelnya tetap di harga asli). Dikalibrasi untuk skala harga Auto + 'Skalakan chart harga saja'. Naikkan bila label masih bertumpuk (layar kecil/pane pendek/skala manual), turunkan bila terlalu renggang.")
colMain     = input.color(#2962FF, "Hitungan utama", group = grpV)
colAlt      = input.color(color.gray, "Hitungan alternatif", group = grpV)
colHist     = input.color(#26A69A, "Pola historis", group = grpV)
colTgt      = input.color(#FF9800, "Target", group = grpV)
colInv      = input.color(#F23645, "Level batal", group = grpV)

// ───────── Threshold ─────────
pctForSec(int sec) =>
    sec >= 2419200 ? 30.0 : sec >= 604800 ? 15.0 : sec >= 86400 ? 6.0 : sec >= 14400 ? 2.5 : sec >= 3600 ? 1.2 : sec >= 900 ? 0.6 : 0.3

tfSec   = timeframe.in_seconds()
autoPct = pctForSec(tfSec)
atrPct  = ta.atr(atrLen) / close * atrMult * 100
thr     = (thrMode == "Auto" ? autoPct : thrMode == "Persen" ? thrPctIn : atrPct) / 100

// ───────── Arah swing HTF ─────────
htfTf  = tfSec >= 2419200 ? "" : tfSec >= 604800 ? "1M" : tfSec >= 86400 ? "1W" : tfSec >= 14400 ? "1D" : tfSec >= 3600 ? "240" : tfSec >= 900 ? "60" : "15"
htfThr = htfTf == "" ? 0.0 : pctForSec(timeframe.in_seconds(htfTf)) / 100

htfSwingDir(float t) =>
    var int   d   = 0
    var float ext = na
    var float hiX = na
    var float loX = na
    if d == 0
        hiX := na(hiX) ? high : math.max(hiX, high)
        loX := na(loX) ? low : math.min(loX, low)
        if hiX >= loX * (1 + t)
            d   := close >= (hiX + loX) / 2 ? 1 : -1
            ext := d == 1 ? hiX : loX
    else if d == 1
        if high > ext
            ext := high
        else if low <= ext * (1 - t)
            d   := -1
            ext := low
    else
        if low < ext
            ext := low
        else if high >= ext * (1 + t)
            d   := 1
            ext := high
    d

htfDirRaw = request.security(syminfo.tickerid, htfTf == "" ? timeframe.period : htfTf, htfSwingDir(htfThr))
htfDir    = useHtf and htfTf != "" ? htfDirRaw : 0

// ───────── Zigzag ─────────
// Elemen terakhir array selalu ekstrem yang masih berjalan (belum terkonfirmasi).
var pP = array.new<float>()
var pB = array.new<int>()
var pT = array.new<int>()   // 1 = high, -1 = low
var pR = array.new<float>() // RSI di bar pivot
rsiV = ta.rsi(close, rsiLen)
atrV = ta.atr(14)
var int   zzDir = 0
var float iHi   = na
var float iLo   = na
var int   iHiB  = na
var int   iLoB  = na
// Ekstrem berlawanan sejak pivot live terakhir (calon pivot berikutnya).
var float oppExt = na
var int   oppBar = na
var float oppRsi = na
// Candle order block per pivot: untuk pivot low = candle turun terakhir (demand), pivot high = candle naik terakhir (supply).
var pOH = array.new<float>()
var pOL = array.new<float>()
var pOB = array.new<int>()

// Candle berlawanan terakhir dalam 0–5 bar ke belakang (typ -1: candle turun, typ 1: candle naik).
obCandle(int typ) =>
    float oh = na
    float ol = na
    int   ob = -1
    for k = 0 to 5
        bool opp = typ == -1 ? close[k] < open[k] : close[k] > open[k]
        if opp
            oh := high[k]
            ol := low[k]
            ob := bar_index - k
            break
    [oh, ol, ob]

[dmH, dmL, dmB] = obCandle(-1)
[spH, spL, spB] = obCandle(1)

// Menjaga array OB sejajar dengan array pivot (termasuk saat array pivot digeser karena > 500).
addOB(array<float> oh, array<float> ol, array<int> ob, float h, float l, int b, int targetSize) =>
    oh.push(h)
    ol.push(l)
    ob.push(b)
    while oh.size() > targetSize
        oh.shift()
        ol.shift()
        ob.shift()
    oh.size()

addPivot(array<float> pp, array<int> pb, array<int> pt, array<float> pr, float price, int bar, int typ, float rsi) =>
    pp.push(price)
    pb.push(bar)
    pt.push(typ)
    pr.push(rsi)
    if pp.size() > 500
        pp.shift()
        pb.shift()
        pt.shift()
        pr.shift()
    pp.size()

if not na(thr)
    if zzDir == 0
        if na(iHi) or high > iHi
            iHi  := high
            iHiB := bar_index
        if na(iLo) or low < iLo
            iLo  := low
            iLoB := bar_index
        if iHi >= iLo * (1 + thr) and iHiB != iLoB
            // RSI bar awal tidak tersimpan; pivot pertama memakai RSI saat ini (hanya memengaruhi info momentum pivot awal).
            if iHiB > iLoB
                addPivot(pP, pB, pT, pR, iLo, iLoB, -1, rsiV)
                addOB(pOH, pOL, pOB, na, na, -1, pP.size())
                addPivot(pP, pB, pT, pR, iHi, iHiB, 1, rsiV)
                addOB(pOH, pOL, pOB, na, na, -1, pP.size())
                zzDir := 1
            else
                addPivot(pP, pB, pT, pR, iHi, iHiB, 1, rsiV)
                addOB(pOH, pOL, pOB, na, na, -1, pP.size())
                addPivot(pP, pB, pT, pR, iLo, iLoB, -1, rsiV)
                addOB(pOH, pOL, pOB, na, na, -1, pP.size())
                zzDir := -1
    else
        float lastP = pP.last()
        if zzDir == 1
            if high > lastP
                pP.set(pP.size() - 1, high)
                pB.set(pB.size() - 1, bar_index)
                pR.set(pR.size() - 1, rsiV)
                pOH.set(pOH.size() - 1, spH)
                pOL.set(pOL.size() - 1, spL)
                pOB.set(pOB.size() - 1, spB)
                oppExt := na
            else if low <= lastP * (1 - thr)
                addPivot(pP, pB, pT, pR, low, bar_index, -1, rsiV)
                addOB(pOH, pOL, pOB, dmH, dmL, dmB, pP.size())
                zzDir  := -1
                oppExt := na
            else if na(oppExt) or low < oppExt
                oppExt := low
                oppBar := bar_index
                oppRsi := rsiV
        else
            if low < lastP
                pP.set(pP.size() - 1, low)
                pB.set(pB.size() - 1, bar_index)
                pR.set(pR.size() - 1, rsiV)
                pOH.set(pOH.size() - 1, dmH)
                pOL.set(pOL.size() - 1, dmL)
                pOB.set(pOB.size() - 1, dmB)
                oppExt := na
            else if high >= lastP * (1 + thr)
                addPivot(pP, pB, pT, pR, high, bar_index, 1, rsiV)
                addOB(pOH, pOL, pOB, spH, spL, spB, pP.size())
                zzDir  := 1
                oppExt := na
            else if na(oppExt) or high > oppExt
                oppExt := high
                oppBar := bar_index
                oppRsi := rsiV

// ───────── Market structure (BOS / CHoCH), sweep, order block ─────────
// Dari pivot zigzag yang sama: selama leg berjalan, close menembus swing searah sebelumnya (pivot n-3).
// Searah tren struktur = BOS, berlawanan = CHoCH (≈ MSS).
var int    msTrend     = 0
// -1, bukan na: di Pine perbandingan dengan na selalu false, sehingga event tidak pernah tercatat.
var int    brokenHiBar = -1
var int    brokenLoBar = -1
var evBar   = array.new<int>()
var evFrom  = array.new<int>()
var evLvl   = array.new<float>()
var evDir   = array.new<int>()
var evType  = array.new<string>()
var evSwBar = array.new<int>()   // bar sweep searah yang mendahului CHoCH (≤ 20 bar), -1 bila tidak ada
var evSwLvl = array.new<float>()
var evSwFrm = array.new<int>()
// Sweep: wick menembus swing terkonfirmasi terakhir lalu close kembali ke dalam.
var int    sweptHiBar = -1
var int    sweptLoBar = -1
var int    lastSwBar  = -1
var int    lastSwDir  = 0
var float  lastSwLvl  = na
var int    lastSwFrom = -1
var swBar  = array.new<int>()
var swFrom = array.new<int>()
var swLvl  = array.new<float>()
var swDir  = array.new<int>()
// Order block dari candle berlawanan terakhir di awal leg yang menghasilkan BOS/CHoCH; "mitigated" saat pertama disentuh.
var obTop  = array.new<float>()
var obBot  = array.new<float>()
var obLeft = array.new<int>()
var obDir  = array.new<int>()
var obMit  = array.new<bool>()

if zzDir != 0 and pP.size() >= 3
    int   mPv = pP.size()
    float lv  = pP.get(mPv - 3)
    int   lvB = pB.get(mPv - 3)
    int   evD = 0
    if zzDir == 1 and close > lv and lvB != brokenHiBar
        evD := 1
        brokenHiBar := lvB
    else if zzDir == -1 and close < lv and lvB != brokenLoBar
        evD := -1
        brokenLoBar := lvB
    if evD != 0
        bool isChoch = msTrend == -evD
        bool withSw  = isChoch and lastSwDir == evD and lastSwBar >= 0 and bar_index - lastSwBar <= 20
        evBar.push(bar_index)
        evFrom.push(lvB)
        evLvl.push(lv)
        evDir.push(evD)
        evType.push(isChoch ? "CHoCH" : "BOS")
        evSwBar.push(withSw ? lastSwBar : -1)
        evSwLvl.push(withSw ? lastSwLvl : na)
        evSwFrm.push(withSw ? lastSwFrom : -1)
        msTrend := evD
        if evBar.size() > 200
            evBar.shift()
            evFrom.shift()
            evLvl.shift()
            evDir.shift()
            evType.shift()
            evSwBar.shift()
            evSwLvl.shift()
            evSwFrm.shift()
        // OB = candle berlawanan di pivot awal leg (n-2).
        float oT = pOH.get(mPv - 2)
        float oB = pOL.get(mPv - 2)
        if not na(oT) and not na(oB)
            obTop.push(oT)
            obBot.push(oB)
            obLeft.push(pOB.get(mPv - 2))
            obDir.push(evD)
            obMit.push(false)
            if obTop.size() > 100
                obTop.shift()
                obBot.shift()
                obLeft.shift()
                obDir.shift()
                obMit.shift()

if zzDir != 0 and pP.size() >= 4
    int mm  = pP.size()
    int hiI = pT.get(mm - 1) == 1 ? mm - 3 : mm - 2
    int loI = pT.get(mm - 1) == -1 ? mm - 3 : mm - 2
    int swD = 0
    int swI = -1
    if high > pP.get(hiI) and close < pP.get(hiI) and pB.get(hiI) != sweptHiBar
        sweptHiBar := pB.get(hiI)
        swD := -1
        swI := hiI
    else if low < pP.get(loI) and close > pP.get(loI) and pB.get(loI) != sweptLoBar
        sweptLoBar := pB.get(loI)
        swD := 1
        swI := loI
    if swD != 0
        lastSwBar  := bar_index
        lastSwDir  := swD
        lastSwLvl  := pP.get(swI)
        lastSwFrom := pB.get(swI)
        swBar.push(bar_index)
        swFrom.push(pB.get(swI))
        swLvl.push(pP.get(swI))
        swDir.push(swD)
        if swBar.size() > 200
            swBar.shift()
            swFrom.shift()
            swLvl.shift()
            swDir.shift()

// Mitigasi OB: disentuh pertama kali sesudah terbentuk (bar setelah break).
if obTop.size() > 0
    for j = 0 to obTop.size() - 1
        if not obMit.get(j)
            if obDir.get(j) == 1 ? low <= obTop.get(j) : high >= obBot.get(j)
                // Bar terbentuknya (event BOS) juga bisa menyentuh zona; tetap dihitung mitigasi agar konservatif.
                obMit.set(j, true)

// ───────── Fair value gap ─────────
// Bullish: low > high 2 bar sebelumnya; bearish: high < low 2 bar sebelumnya. Hanya yang ≥ fvgMinAtr × ATR.
var fvTop  = array.new<float>()
var fvBot  = array.new<float>()
var fvLeft = array.new<int>()
var fvDir  = array.new<int>()
var fvMit  = array.new<bool>()

if not na(atrV) and bar_index >= 2
    int   fd = 0
    float ft = na
    float fb = na
    if low > high[2] and low - high[2] >= fvgMinAtr * atrV
        fd := 1
        ft := low
        fb := high[2]
    else if high < low[2] and low[2] - high >= fvgMinAtr * atrV
        fd := -1
        ft := low[2]
        fb := high
    // Mitigasi diperiksa sebelum FVG baru dicatat: bar pembentuk selalu menempel di tepi zonanya sendiri.
    if fvTop.size() > 0
        for j = 0 to fvTop.size() - 1
            if not fvMit.get(j)
                if fvDir.get(j) == 1 ? low <= fvTop.get(j) : high >= fvBot.get(j)
                    fvMit.set(j, true)
    if fd != 0
        fvTop.push(ft)
        fvBot.push(fb)
        fvLeft.push(bar_index - 2)
        fvDir.push(fd)
        fvMit.push(false)
        if fvTop.size() > 150
            fvTop.shift()
            fvBot.shift()
            fvLeft.shift()
            fvDir.shift()
            fvMit.shift()

// ───────── Penghitungan gelombang ─────────
type Count
    float      score
    int        m      // indeks titik terakhir: 3–5 = impuls berjalan, 6/7/8 = A/B/C berjalan
    int        sgn    // 1 = impuls naik, -1 = impuls turun
    bool       diag
    bool       trunc
    bool       thin   // lolos aturan dengan margin sangat tipis
    array<int> sel    // indeks pivot untuk titik 0..m

// 0 = valid; 1 = ada pivot di tengah yang melewati titik awal (coba titik awal lebih jauh);
// 2 = ada pivot di tengah yang melewati titik akhir (semua titik awal yang lebih jauh juga gagal).
segCheck(array<float> pp, int a, int b) =>
    float pa  = pp.get(a)
    float pb  = pp.get(b)
    float lo  = math.min(pa, pb)
    float hi  = math.max(pa, pb)
    int   res = 0
    if b - a >= 2
        for t = a + 1 to b - 1
            float v = pp.get(t)
            bool beyondB = pb > pa ? v > pb : v < pb
            if beyondB
                res := 2
                break
            if v < lo or v > hi
                res := 1
    res

lenAt(array<float> pp, array<int> sel, int i) =>
    math.abs(pp.get(sel.get(i)) - pp.get(sel.get(i - 1)))

// isLive: titik ke-m masih berjalan, jadi aturannya tetap dicek tapi rasionya tidak dinilai.
// Pola historis (isLive = false) menilai semua gelombang termasuk yang terakhir.
evalCount(array<float> pp, array<int> sel, int m, int sgn, float winRange, bool allowDg, int hDir, bool isLive) =>
    int sm = isLive ? m : m + 1
    vals = array.new<float>(m + 1, 0.0)
    for i = 0 to m
        vals.set(i, sgn * pp.get(sel.get(i)))
    lens = array.new<float>(m + 1, 0.0)
    for i = 1 to m
        lens.set(i, math.abs(vals.get(i) - vals.get(i - 1)))
    bool  ok    = true
    bool  diag  = false
    bool  trunc = false
    bool  thin  = false
    float s     = 0.0
    float c     = 0.0
    float L1 = lens.get(1)
    float L2 = lens.get(2)
    float L3 = lens.get(3)
    float L4 = na
    float L5 = na
    if m >= 4
        L4 := lens.get(4)
    if m >= 5
        L5 := lens.get(5)

    // W2 tidak boleh melewati awal W1
    if vals.get(2) <= vals.get(0)
        ok := false
    float r2 = L2 / L1
    s += r2 >= 0.5 and r2 <= 0.786 ? 1.0 : r2 >= 0.382 and r2 <= 0.887 ? 0.5 : 0.0
    c += 1

    // W3 harus melewati ujung W1 (kecuali masih berjalan)
    if sm > 3
        if vals.get(3) <= vals.get(1)
            ok := false
        float x3 = L3 / L1
        s += x3 >= 1.618 and x3 <= 2.618 ? 1.0 : x3 >= 1.272 and x3 <= 4.236 ? 0.6 : 0.3
        c += 1

    // W4 tidak boleh overlap W1, kecuali diagonal menyempit
    if m >= 4
        if vals.get(4) <= vals.get(1)
            if allowDg and L3 < L1 and L4 < L2
                diag := true
            else
                ok := false
        else if (vals.get(4) - vals.get(1)) / L1 < 0.02
            thin := true
        if sm > 4
            float r4 = L4 / L3
            s += r4 >= 0.236 and r4 <= 0.382 ? 1.0 : r4 <= 0.5 ? 0.6 : 0.2
            c += 1
            s += (r2 >= 0.5) != (r4 >= 0.5) ? 0.5 : 0.0   // alternation
            c += 0.5

    // W3 tidak boleh terpendek; diagonal menyempit butuh W5 < W3
    if m >= 5
        if diag
            if L5 >= L3
                ok := false
        else if L3 < L1 and L3 < L5
            ok := false
        else
            float minOther = math.min(L1, L5)
            if L3 < math.max(L1, L5) and (L3 - minOther) / minOther < 0.05
                thin := true
        if sm > 5
            if vals.get(5) <= vals.get(3)
                trunc := true
            float e1  = L5 / L1
            float e03 = L5 / math.abs(vals.get(3) - vals.get(0))
            s += (e1 >= 0.85 and e1 <= 1.15) or (e03 >= 0.55 and e03 <= 0.68) or (e1 >= 1.5 and e1 <= 1.7) ? 1.0 : 0.3
            c += 1

    // Koreksi A-B-C setelah impuls selesai
    if sm > 6
        float rA = lens.get(6) / math.abs(vals.get(5) - vals.get(0))
        s += rA >= 0.236 and rA <= 0.786 ? 1.0 : 0.5
        c += 1
    if m >= 7
        float rB = lens.get(7) / lens.get(6)
        if rB > 1.382
            ok := false
        if sm > 7
            s += (rB >= 0.382 and rB <= 0.886) or (rB >= 1.0 and rB <= 1.382) ? 1.0 : 0.5
            c += 1
        // C yang masih berjalan tapi sudah > 2.618×A hampir pasti salah hitung (lebih mungkin impuls baru).
        if m >= 8 and isLive and lens.get(8) / lens.get(6) > 2.618
            ok := false
        // C yang sudah selesai: pada zigzag (B < 0.786A) C wajib melewati ujung A.
        if sm > 8
            if rB < 0.786 and vals.get(8) >= vals.get(6)
                ok := false
            float rC = lens.get(8) / lens.get(6)
            s += (rC >= 0.618 and rC <= 1.0) or (rC >= 1.5 and rC <= 1.7) ? 1.0 : 0.5
            c += 1

    float span  = winRange > 0 ? (vals.max() - vals.min()) / winRange : 0.0
    // Ditarik ke 0.5 dengan bobot 2 rasio: hitungan parsial dengan 1 rasio cocok tidak boleh dapat fit = 1.
    float fit   = (s + 1.0) / (c + 2.0)
    // Koreksi (m >= 6) bergerak melawan impuls, jadi derajat induknya berarah -sgn.
    int   parentDir = m <= 5 ? sgn : -sgn
    float htfAdj    = hDir == 0 ? 0.0 : parentDir == hDir ? 0.05 : -0.05
    float score = ok ? 0.55 * fit + 0.35 * span + 0.10 * m / 8.0 + htfAdj - (diag ? 0.05 : 0.0) - (trunc ? 0.15 : 0.0) - (thin ? 0.03 : 0.0) : na
    [score, diag, trunc, thin]

// DFS mundur dari endIdx: pilih titik k dari pivot yang lebih tua, berselang 2 agar tipe high/low tetap bergantian.
searchBest(array<float> pp, int endIdx, int startBound, int m, int sgn, float winRange, bool allowDg, int hDir, bool isLive) =>
    Count best = na
    sel = array.new<int>(m + 1, 0)
    sel.set(m, endIdx)
    int k = m - 1
    sel.set(k, endIdx - 1)
    while k < m
        int j = sel.get(k)
        if j < startBound + k
            k += 1
            if k < m
                sel.set(k, sel.get(k) - 2)
            continue
        int res = segCheck(pp, j, sel.get(k + 1))
        if res == 2
            k += 1
            if k < m
                sel.set(k, sel.get(k) - 2)
            continue
        if res == 1
            sel.set(k, j - 2)
            continue
        if k == 0
            [sc, dg, tr, th] = evalCount(pp, sel, m, sgn, winRange, allowDg, hDir, isLive)
            if not na(sc) and (na(best) or sc > best.score)
                best := Count.new(sc, m, sgn, dg, tr, th, sel.copy())
            sel.set(0, j - 2)
        else
            k -= 1
            sel.set(k, sel.get(k + 1) - 1)
    best

waveName(int k) =>
    k <= 5 ? str.tostring(k) : k == 6 ? "A" : k == 7 ? "B" : "C"

fmtR(float r) =>
    str.tostring(r, "0.000")

toPx(float v, bool isLog) =>
    isLog ? math.exp(v) : v

isNear(float a, float b, float tolPct, bool isLog) =>
    isLog ? math.abs(a - b) <= math.log(1 + tolPct / 100) : math.abs(a - b) <= tolPct / 100 * math.abs(b)

pointRatio(array<float> pp, array<int> sel, int k) =>
    string out = ""
    if k == 2
        out := str.tostring(lenAt(pp, sel, 2) / lenAt(pp, sel, 1), "0.000")
    else if k == 3
        out := str.tostring(lenAt(pp, sel, 3) / lenAt(pp, sel, 1), "0.000") + "×W1"
    else if k == 4
        out := str.tostring(lenAt(pp, sel, 4) / lenAt(pp, sel, 3), "0.000")
    else if k == 5
        out := str.tostring(lenAt(pp, sel, 5) / lenAt(pp, sel, 1), "0.000") + "×W1"
    else if k == 6
        out := str.tostring(lenAt(pp, sel, 6) / math.abs(pp.get(sel.get(5)) - pp.get(sel.get(0))), "0.000")
    else if k == 7
        out := str.tostring(lenAt(pp, sel, 7) / lenAt(pp, sel, 6), "0.000")
    else if k == 8
        out := str.tostring(lenAt(pp, sel, 8) / lenAt(pp, sel, 6), "0.000") + "×A"
    out

describe(Count c, array<float> pp) =>
    string d = c.sgn == 1 ? "naik" : "turun"
    string t = c.m <= 5 ? "Impuls " + d + " · gelombang " + str.tostring(c.m) + " berjalan" : "Gelombang " + waveName(c.m) + " berjalan setelah impuls " + d
    if c.diag
        t += " · diagonal"
    if c.trunc
        t += " · W5 truncation"
    if c.thin
        t += " · lolos tipis"
    if c.m == 8
        t += lenAt(pp, c.sel, 7) / lenAt(pp, c.sel, 6) >= 0.786 ? " · flat" : " · zigzag"
    t + " · skor " + str.tostring(c.score, "0.00")

// Target dan level batal untuk gelombang yang sedang berjalan.
// pp di sini harga ruang hitung (log bila isLog); keluaran sudah dikonversi ke harga chart.
computeLevels(Count c, array<float> pp, bool isLog) =>
    tp  = array.new<float>()
    tn  = array.new<string>()
    ip  = array.new<float>()
    inm = array.new<string>()
    isd = array.new<int>()   // 1 = batal jika harga di atas level, -1 = di bawah
    int   m = c.m
    float s = c.sgn
    float P0 = pp.get(c.sel.get(0))
    float P1 = pp.get(c.sel.get(1))
    float P2 = pp.get(c.sel.get(2))
    float P3 = pp.get(c.sel.get(3))
    float P4 = na
    float P5 = na
    float P6 = na
    float P7 = na
    if m >= 4
        P4 := pp.get(c.sel.get(4))
    if m >= 5
        P5 := pp.get(c.sel.get(5))
    if m >= 6
        P6 := pp.get(c.sel.get(6))
    if m >= 7
        P7 := pp.get(c.sel.get(7))
    float L1 = math.abs(P1 - P0)
    float L3 = math.abs(P3 - P2)

    if m == 3
        tp.push(P2 + s * L1 * 1.618), tn.push("W3 1.618×W1")
        tp.push(P2 + s * L1 * 2.618), tn.push("W3 2.618×W1")
        ip.push(P0), inm.push("W2 lewat awal W1"), isd.push(-c.sgn)
    else if m == 4
        tp.push(P3 - s * L3 * 0.236), tn.push("W4 0.236")
        tp.push(P3 - s * L3 * 0.382), tn.push("W4 0.382")
        tp.push(P3 - s * L3 * 0.5),   tn.push("W4 0.5")
        ip.push(c.diag ? P2 : P1), inm.push(c.diag ? "W4 lewat ujung W2" : "W4 overlap W1"), isd.push(-c.sgn)
    else if m == 5
        tp.push(P4 + s * L1),                       tn.push("W5 = W1")
        tp.push(P4 + s * math.abs(P3 - P0) * 0.618), tn.push("W5 0.618×(0–3)")
        ip.push(c.diag ? P2 : P1), inm.push(c.diag ? "lewat ujung W2" : "overlap W1"), isd.push(-c.sgn)
        if c.diag or L3 < L1
            ip.push(P4 + s * L3), inm.push("W5 > W3 (W3 jadi terpendek)"), isd.push(c.sgn)
    else if m == 6
        float imp = math.abs(P5 - P0)
        tp.push(P5 - s * imp * 0.382), tn.push("A 0.382 impuls")
        tp.push(P5 - s * imp * 0.5),   tn.push("A 0.5 impuls")
        tp.push(P5 - s * imp * 0.618), tn.push("A 0.618 impuls")
        tp.push(P4),                   tn.push("Area W4")
        ip.push(P5), inm.push("lewat ujung W5"), isd.push(c.sgn)
    else if m == 7
        float LA = math.abs(P6 - P5)
        tp.push(P6 + s * LA * 0.5),   tn.push("B 0.5×A")
        tp.push(P6 + s * LA * 0.618), tn.push("B 0.618×A")
        tp.push(P6 + s * LA * 0.786), tn.push("B 0.786×A")
        ip.push(P6 + s * LA * 1.382), inm.push("B > 1.382×A"), isd.push(c.sgn)
    else if m == 8
        float LA = math.abs(P6 - P5)
        tp.push(P7 - s * LA * 0.618), tn.push("C 0.618×A")
        tp.push(P7 - s * LA),         tn.push("C = A")
        tp.push(P7 - s * LA * 1.618), tn.push("C 1.618×A")
        tp.push(P5 - s * math.abs(P5 - P0) * 0.382), tn.push("0.382 impuls")
        tp.push(P5 - s * math.abs(P5 - P0) * 0.618), tn.push("0.618 impuls")
        ip.push(P7), inm.push("lewat ujung B"), isd.push(c.sgn)
    for i = 0 to tp.size() - 1
        tp.set(i, toPx(tp.get(i), isLog))
    for i = 0 to ip.size() - 1
        ip.set(i, toPx(ip.get(i), isLog))
    [tp, tn, ip, inm, isd]

// Urutan pilihan rasio untuk satu gelombang proyeksi:
// 1) rasio (yang belum dilewati harga, bila gelombangnya sedang berjalan) yang berdekatan dengan level penting lain di pool;
// 2) kalau tidak ada konfluens, rasio pertama yang belum dilewati;
// 3) kalau semua sudah dilewati, gelombang dianggap berakhir di ekstrem saat ini.
pickLevel(float base, float unit, float dir, array<float> fibs, string unitName, bool isLive, float liveC, array<float> pool, array<string> poolN, float tolPct, bool isLog) =>
    float  out       = na
    string why       = ""
    float  firstOk   = na
    string firstName = ""
    for f in fibs
        float lv = base + dir * unit * f
        if not isLive or dir * (lv - liveC) > 0
            if na(firstOk)
                firstOk   := lv
                firstName := fmtR(f) + "×" + unitName
            if na(out) and pool.size() > 0
                for j = 0 to pool.size() - 1
                    if isNear(lv, pool.get(j), tolPct, isLog)
                        out := lv
                        why := fmtR(f) + "×" + unitName + ", berdekatan dengan " + poolN.get(j) + " " + str.tostring(toPx(pool.get(j), isLog), format.mintick) + " (konfluens)"
                        break
    if na(out)
        if not na(firstOk)
            out := firstOk
            why := firstName + (isLive ? ", rasio pertama yang belum dilewati harga" : ", rasio standar gelombang ini")
        else
            out := liveC
            why := "semua rasio sudah dilewati harga, jadi dianggap berakhir di ekstrem saat ini"
    [out, why]

// Hasil uji walk-forward (BTC 1W/1D/4h/1h, ETH 1D/4h, SOL 1D, BNB 1D; skala log; Nov 2026):
// seberapa sering target gelombang yang sedang berjalan tercapai sebelum stop di sisi berlawanan,
// dibanding peluang acak (random walk) untuk jarak target/stop yang sama.
backtestNote(int k) =>
    k == 3 ? "Uji historis W3: tercapai 37.3% vs acak 34.7% (+2.6 poin, n=1302)" :
     k == 4 ? "Uji historis W4: tercapai 56.3% vs acak 60.3% (−4.0 poin, n=458) — target W4 tidak lebih baik dari acak" :
     k == 5 ? "Uji historis W5: tercapai 56.8% vs acak 52.6% (+4.2 poin, n=711)" :
     k == 6 ? "Uji historis A: tercapai 35.9% vs acak 36.5% (≈ acak, n=593)" :
     k == 7 ? "Uji historis B: tercapai 57.8% vs acak 58.5% (≈ acak, n=1461)" :
     "Uji historis C: tercapai 46.1% vs acak 44.3% (+1.8 poin, n=2031)"

// pp di sini harga ruang hitung (log bila isLog); outY sudah dikonversi ke harga chart.
projectPath(Count c, array<float> pp, array<int> pb, int legs, int nowBar, float tolPct, bool isLog) =>
    px = array.new<float>(9, na)
    bx = array.new<int>(9, 0)
    for i = 0 to c.m
        px.set(i, pp.get(c.sel.get(i)))
        bx.set(i, pb.get(c.sel.get(i)))
    float liveC = px.get(c.m)
    float s     = c.sgn
    outX = array.new<int>()
    outY = array.new<float>()
    outN = array.new<string>()
    outW = array.new<string>()
    int kEnd = math.min(8, c.m + legs - 1)
    for k = c.m to kEnd
        bool  live  = k == c.m
        float dirK  = s * (k % 2 == 1 ? 1 : -1)
        float E     = na
        string why  = ""
        string tWhy = ""
        int   dur   = 1
        pool  = array.new<float>()
        poolN = array.new<string>()
        if k == 3
            [e, w] = pickLevel(px.get(2), math.abs(px.get(1) - px.get(0)), dirK, live ? array.from(1.618, 2.618, 4.236) : array.from(1.618), "W1", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            dur  := bx.get(1) - bx.get(0)
            tWhy := "durasi ≈ W1"
        else if k == 4
            float L3 = math.abs(px.get(3) - px.get(2))
            [e, w] = pickLevel(px.get(3), L3, dirK, live ? array.from(0.236, 0.382, 0.5, 0.618) : array.from(0.382), "W3", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            if not c.diag and s * (E - px.get(1)) <= 0
                E   := px.get(3) + dirK * L3 * 0.236
                why += "; digeser ke 0.236×W3 agar tidak overlap W1"
            dur  := bx.get(2) - bx.get(1)
            tWhy := "durasi ≈ W2"
        else if k == 5
            pool.push(px.get(4) + dirK * math.abs(px.get(3) - px.get(0)) * 0.618), poolN.push("0.618×(0–3)")
            [e, w] = pickLevel(px.get(4), math.abs(px.get(1) - px.get(0)), dirK, live ? array.from(1.0, 1.618) : array.from(1.0), "W1", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            dur  := bx.get(1) - bx.get(0)
            tWhy := "durasi ≈ W1"
        else if k == 6
            pool.push(px.get(4)), poolN.push("ujung W4")
            [e, w] = pickLevel(px.get(5), math.abs(px.get(5) - px.get(0)), dirK, live ? array.from(0.382, 0.5, 0.618) : array.from(0.382), "impuls", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            dur  := bx.get(5) - bx.get(4)
            tWhy := "durasi ≈ W5"
        else if k == 7
            [e, w] = pickLevel(px.get(6), math.abs(px.get(6) - px.get(5)), dirK, live ? array.from(0.5, 0.618, 0.786) : array.from(0.618), "A", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            dur  := bx.get(6) - bx.get(5)
            tWhy := "durasi ≈ A"
        else if k == 8
            float imp = math.abs(px.get(5) - px.get(0))
            pool.push(px.get(5) + dirK * imp * 0.382), poolN.push("0.382 impuls")
            pool.push(px.get(5) + dirK * imp * 0.5),   poolN.push("0.5 impuls")
            pool.push(px.get(5) + dirK * imp * 0.618), poolN.push("0.618 impuls")
            pool.push(px.get(4)),                      poolN.push("ujung W4")
            [e, w] = pickLevel(px.get(7), math.abs(px.get(6) - px.get(5)), dirK, live ? array.from(0.618, 1.0, 1.618) : array.from(1.0), "A", live, liveC, pool, poolN, tolPct, isLog)
            E   := e
            why := w
            dur  := bx.get(6) - bx.get(5)
            tWhy := "durasi ≈ A"
        int x = bx.get(k - 1) + math.max(dur, 1)
        if live
            x := math.max(x, nowBar + 1)
        x := math.min(math.max(x, bx.get(k - 1) + 1), nowBar + 480)
        px.set(k, E)
        bx.set(k, x)
        outX.push(x)
        // Semua rasio sudah terlewati: titik proyeksi = titik live, tidak perlu label ganda.
        outY.push(live and E == liveC ? na : toPx(E, isLog))
        outN.push(waveName(k) + "?")
        outW.push("Harga: " + why + (isLog ? " (skala log)" : "") + "\nWaktu: " + tWhy + ", " + str.tostring(math.max(dur, 1)) + " bar" + (live ? "\nGelombang ini sedang berjalan." : "\nBelum terjadi: dihitung dari ujung proyeksi sebelumnya.") + "\n\n" + backtestNote(k))
    [outX, outY, outN, outW]

// Alasan titik ke-k dipilih, ditampilkan sebagai tooltip label.
// pp = harga chart (untuk ditampilkan), cp = harga ruang hitung (untuk rasio).
pointTip(Count c, array<float> pp, array<float> cp, int k, bool isLive) =>
    float  pr   = pp.get(c.sel.get(k))
    string px   = str.tostring(pr, format.mintick)
    bool   up   = c.sgn == 1
    float  L1   = lenAt(cp, c.sel, 1)
    string t    = ""
    if k == 0
        t := "Gelombang 0 di " + px + "\nDipilih karena ini " + (up ? "low terendah" : "high tertinggi") + " di segmen 0→1: tidak ada pivot di antaranya yang melewati titik ini, jadi anchor ada di ekstrem absolut." + "\nDari semua kandidat titik 0 yang lolos aturan, kombinasi ini skornya tertinggi." + "\nLevel ini juga batas: W2 tidak boleh melewatinya."
    else if k == 1
        t := "Ujung W1 di " + px + "\nTitik ini " + (up ? "high tertinggi" : "low terendah") + " sebelum koreksi W2. Panjang W1 = " + str.tostring(lenAt(pp, c.sel, 1), format.mintick) + " (acuan rasio W3 dan W5)."
    else if k == 2
        t := "Ujung W2 di " + px + "\nRetrace " + fmtR(lenAt(cp, c.sel, 2) / L1) + " dari W1 (panduan 0.5–0.786).\nAturan: W2 tidak melewati titik 0 ✓"
    else if k == 3
        t := "Ujung W3 di " + px + "\nPanjang " + fmtR(lenAt(cp, c.sel, 3) / L1) + "×W1 (panduan 1.618–2.618)."
        if not (isLive and c.m == 3)
            t += "\nAturan: W3 melewati ujung W1 ✓"
        if c.m >= 5 and not c.diag
            t += "\nAturan: W3 bukan gelombang terpendek ✓"
    else if k == 4
        t := "Ujung W4 di " + px + "\nRetrace " + fmtR(lenAt(cp, c.sel, 4) / lenAt(cp, c.sel, 3)) + " dari W3 (panduan 0.236–0.382)."
        t += c.diag ? "\nOverlap dengan W1 diterima karena polanya diagonal menyempit (W3 < W1, W4 < W2)." : "\nAturan: tidak overlap W1, jarak " + str.tostring(math.abs(pr - pp.get(c.sel.get(1))), format.mintick) + " ✓"
    else if k == 5
        t := "Ujung W5 di " + px + "\nPanjang " + fmtR(lenAt(cp, c.sel, 5) / L1) + "×W1 (panduan: = W1, atau 0.618×(0–3))."
        if c.trunc
            t += "\nTruncation: W5 tidak melewati ujung W3."
        t += "\nImpuls 5 gelombang lengkap di sini, jadi gerak berikutnya dihitung sebagai koreksi A-B-C."
    else if k == 6
        t := "Ujung A di " + px + "\nRetrace " + fmtR(lenAt(cp, c.sel, 6) / math.abs(cp.get(c.sel.get(5)) - cp.get(c.sel.get(0)))) + " dari seluruh impuls 0–5." + "\nA dimulai dari titik 5 karena impuls 0–5 sudah lengkap dan lolos semua aturan (W2 tidak lewat 0, W3 bukan terpendek, W4 tidak overlap W1). Gerak pertama yang melawan impuls adalah A."
    else if k == 7
        float rB = lenAt(cp, c.sel, 7) / lenAt(cp, c.sel, 6)
        t := "Ujung B di " + px + "\nB = " + fmtR(rB) + "×A → " + (rB >= 0.786 ? "pola flat (B ≥ 0.786A)" : "pola zigzag (B < 0.786A)") + ".\nAturan: B tidak lebih dari 1.382×A ✓"
    else
        t := "Ujung C di " + px + "\nC = " + fmtR(lenAt(cp, c.sel, 8) / lenAt(cp, c.sel, 6)) + "×A (panduan 0.618–1.0, atau 1.618)."
    if isLive and k == c.m
        t += "\n\nMasih berjalan: titik ini ikut bergeser selama harga membuat ekstrem baru."
    t + "\n\nSkor hitungan: " + str.tostring(c.score, "0.00") + (useLog ? " · rasio skala log" : "")

// Pivot yang dipakai kedua hitungan cukup diberi satu label: nama alternatif ditempel di label utama.
// bpc = lebar satu karakter dalam bar. Label selalu di tengah titiknya; fungsi mengembalikan berapa bar teks label
// melewati bar terakhir, supaya label level di kanan digeser secukupnya dan tidak tertimpa. bx*/by* = kotak perkiraan label gelombang yang sudah digambar (hitungan utama
// digambar lebih dulu, lalu alternatif, lalu historis), dipakai untuk menggeser label yang akan menimpa.
drawCount(Count c, Count other, string startAlias, array<float> pp, array<float> cp, array<int> pb, array<int> pt, color col, bool primary, float bpc, float lineH, array<float> bx1, array<float> bx2, array<float> by1, array<float> by2, array<label> labs, array<line> lns) =>
    float over = 0.0
    for k = 0 to c.m
        int   idx    = c.sel.get(k)
        float y      = pp.get(idx)
        int   x      = pb.get(idx)
        bool  isHigh = pt.get(idx) == 1
        int   oj     = -1
        if not na(other)
            oj := other.sel.indexof(idx)
        string nm = primary ? waveName(k) : "(" + waveName(k) + ")"
        if k == c.m
            nm += "?"
        if k == 0 and startAlias != ""
            nm := startAlias + " / " + nm
        if primary and oj >= 0
            nm += " · (" + waveName(oj) + (oj == other.m ? "?" : "") + ")"
        string rt  = primary ? pointRatio(cp, c.sel, k) : ""
        string pv  = str.tostring(y, format.mintick)
        string det = rt == "" ? pv : rt + " · " + pv
        // Satu baris: label dua pivot yang berdekatan tidak saling tindih secara vertikal.
        string txt = nm + " · " + det
        string tip = pointTip(c, pp, cp, k, true)
        if k == 0 and startAlias != ""
            tip := "Titik ini juga akhir gelombang " + startAlias + " dari pola historis sebelumnya.\n\n" + tip
        float w  = str.length(txt) * bpc * (primary ? 1.2 : 1.0)
        float lh = lineH * (primary ? 1.2 : 1.0)
        float l1 = x - w / 2
        float l2 = x + w / 2
        float t1 = isHigh ? y : y - lh
        float t2 = t1 + lh
        // Setiap titik gelombang tetap berlabel: bila menimpa label yang sudah ada, label digeser menjauhi pivot
        // (ke atas untuk high, ke bawah untuk low) maksimal 4 baris; bila masih menimpa, tetap ditulis di posisi terakhir.
        float yl = y
        if bx1.size() > 0
            for tries = 0 to 3
                bool hitP = false
                for q = 0 to bx1.size() - 1
                    if l1 < bx2.get(q) and l2 > bx1.get(q) and t1 < by2.get(q) and t2 > by1.get(q)
                        hitP := true
                        break
                if not hitP
                    break
                float d = isHigh ? lh : -lh
                t1 += d
                t2 += d
                yl += d
        if primary or oj < 0
            bx1.push(l1)
            bx2.push(l2)
            by1.push(t1)
            by2.push(t2)
            over := math.max(over, l2 - bar_index)
            labs.push(label.new(x, yl, txt, style = isHigh ? label.style_label_down : label.style_label_up,
                 color = color.new(col, 100), textcolor = col, size = primary ? size.normal : size.small,
                 tooltip = (primary ? "Hitungan utama\n" : "Hitungan alternatif\n") + tip, force_overlay = true))
        if k > 0
            int pidx = c.sel.get(k - 1)
            lns.push(line.new(pb.get(pidx), pp.get(pidx), x, y, color = col, width = primary ? 2 : 1,
                 style = primary ? line.style_solid : line.style_dashed, force_overlay = true))
    over

// skipIdx: pivot yang sudah dilabeli hitungan utama (titik 0-nya), labelnya digabung lewat startAlias.
// Label yang menimpa label lain di registri bx*/by* (hitungan utama/alternatif, pola historis sebelumnya) digeser
// menjauhi pivot, sama seperti drawCount.
drawHist(Count c, array<float> pp, array<float> cp, array<int> pb, array<int> pt, color col, bool skipFirst, int skipIdx, float bpc, float lineH, array<float> bx1, array<float> bx2, array<float> by1, array<float> by2, array<label> labs, array<line> lns) =>
    for k = 0 to c.m
        int   idx    = c.sel.get(k)
        float y      = pp.get(idx)
        int   x      = pb.get(idx)
        bool  isHigh = pt.get(idx) == 1
        string pv    = str.tostring(y, format.mintick)
        string txt   = waveName(k) + " · " + pv
        float  w     = str.length(txt) * bpc
        float  l1    = x - w / 2
        float  l2    = x + w / 2
        float  t1    = isHigh ? y : y - lineH
        float  t2    = t1 + lineH
        float  yl    = y
        if bx1.size() > 0
            for tries = 0 to 3
                bool hitH = false
                for q = 0 to bx1.size() - 1
                    if l1 < bx2.get(q) and l2 > bx1.get(q) and t1 < by2.get(q) and t2 > by1.get(q)
                        hitH := true
                        break
                if not hitH
                    break
                float d = isHigh ? lineH : -lineH
                t1 += d
                t2 += d
                yl += d
        if not (k == 0 and skipFirst) and idx != skipIdx
            bx1.push(l1)
            bx2.push(l2)
            by1.push(t1)
            by2.push(t2)
            labs.push(label.new(x, yl, txt, style = isHigh ? label.style_label_down : label.style_label_up,
                 color = color.new(col, 100), textcolor = col, size = size.small,
                 tooltip = "Pola historis (selesai)\n" + pointTip(c, pp, cp, k, false), force_overlay = true))
        if k > 0
            int pidx = c.sel.get(k - 1)
            lns.push(line.new(pb.get(pidx), pp.get(pidx), x, y, color = col, width = 1, force_overlay = true))
    c.m

// Kotak zona S/R tanpa teks (teks di dalam kotak menimpa candle & label gelombang).
// Teks dikembalikan untuk ditulis sebagai label di margin kanan bersama label level lain.
// Major: garis tepi tegas & isi lebih pekat; Minor: garis putus-putus & isi tipis.
drawSRZone(float lo, float hi, int t, int leftBar, string kind, bool isMajor, array<float> lv, float atrNow, array<box> bxs) =>
    float pad = math.max(atrNow * 0.25 - (hi - lo) / 2, 0)
    float top = hi + pad
    float bot = lo - pad
    bool  ew  = false
    for v in lv
        if v >= bot and v <= top
            ew := true
            break
    color c = kind == "R" ? #F23645 : kind == "S" ? #089981 : color.gray
    bxs.push(box.new(leftBar, top, bar_index + 3, bot, border_color = color.new(c, isMajor ? 35 : 75), bgcolor = color.new(c, isMajor ? 86 : 94),
         border_width = isMajor ? 2 : 1, border_style = isMajor ? line.style_solid : line.style_dashed, extend = extend.right, force_overlay = true))
    (isMajor ? "Major " : "Minor ") + kind + " " + str.tostring(t) + "× " + str.tostring((lo + hi) / 2, format.mintick) + (ew ? " ★EW" : "")

// Alasan zona digolongkan Major/Minor, untuk tooltip label zona.
srClassTip(float swLog, int touches, float majSwLog, int majT, bool isMajor) =>
    string swTxt = "swing pivot terbesar " + str.tostring((math.exp(swLog) - 1) * 100, "0.0") + "% (Major ≥ " + str.tostring((math.exp(majSwLog) - 1) * 100, "0.0") + "%)"
    string tTxt  = str.tostring(touches) + "× sentuhan (Major ≥ " + str.tostring(majT) + ")"
    (isMajor ? "MAJOR — " : "MINOR — ") + swTxt + " · " + tTxt + (isMajor ? "\nTitik balik derajat lebih tinggi atau level yang berkali-kali diuji; lebih layak dijadikan acuan utama." : "\nLevel swing kecil di dalam tren; lebih mudah ditembus.")

// Label level di margin kanan diantre dulu; posisinya disusun sekaligus di layoutRightLabels.
queueRightLabel(float y, string txt, color col, string tip, array<float> qY, array<string> qT, array<color> qC, array<string> qTip) =>
    qY.push(y)
    qT.push(txt)
    qC.push(col)
    qTip.push(tip)
    qY.size()

// Label di atas harga (mid) disusun dari bawah ke atas dan digeser naik bila berjarak < lineH dari label di bawahnya;
// label di bawah harga disusun dari atas ke bawah dan digeser turun. Jadi label yang paling dekat harga tetap di levelnya,
// dan geseran selalu menjauhi harga (label level jauh tidak terdorong ke area harga). Teks label_lower_left menempati
// [y, y + lineH]. Warna tiap label tetap, garis level tetap di harga asli.
// Mengembalikan posisi y akhir tiap label (urutan antrean) untuk cek tabrakan label proyeksi.
layoutRightLabels(array<float> qY, array<string> qT, array<color> qC, array<string> qTip, int x, float lineH, float mid, array<label> labs) =>
    outY = array.new<float>(qY.size(), na)
    if qY.size() > 0
        ord = qY.sort_indices(order.ascending)
        // Atas: naik dari label pertama yang ≥ mid.
        float nextUp = na
        float lowestUp = na
        for i = 0 to ord.size() - 1
            int j = ord.get(i)
            if qY.get(j) >= mid
                float y = na(nextUp) ? qY.get(j) : math.max(qY.get(j), nextUp)
                outY.set(j, y)
                nextUp := y + lineH
                lowestUp := na(lowestUp) ? y : math.min(lowestUp, y)
        // Bawah: turun dari label tertinggi yang < mid, tidak boleh menyentuh label atas terendah.
        float nextDn = na(lowestUp) ? na : lowestUp - lineH
        for i = ord.size() - 1 to 0
            int j = ord.get(i)
            if qY.get(j) < mid
                float y = na(nextDn) ? qY.get(j) : math.min(qY.get(j), nextDn)
                outY.set(j, y)
                nextDn := y - lineH
        for j = 0 to qY.size() - 1
            float y0 = qY.get(j)
            float y  = outY.get(j)
            string moved = y != y0 ? "\n(Label digeser agar tidak menimpa label lain; level sebenarnya " + str.tostring(y0, format.mintick) + ")" : ""
            labs.push(label.new(x, y, qT.get(j), style = label.style_label_lower_left, color = color.new(qC.get(j), 100), textcolor = qC.get(j),
                 size = size.small, textalign = text.align_left, tooltip = qT.get(j) + "\n" + qTip.get(j) + moved, force_overlay = true))
    outY

// Cara level target dihitung, berdasarkan nama targetnya.
targetExplain(string name) =>
    str.startswith(name, "W3") ? "Ujung W3 diproyeksikan dari ujung W2: panjang W1 dikali rasio Fibonacci. W3 biasanya gelombang terpanjang (umum 1.618–2.618×W1)." :
     str.startswith(name, "W4") ? "Ujung W4 diukur sebagai retrace dari W3 (ditarik balik dari ujung W3). W4 umumnya dangkal (0.236–0.382) dan tidak boleh masuk area W1." :
     name == "W5 = W1" ? "Panjang W5 disamakan dengan W1, ditarik dari ujung W4 — pola paling umum bila W3 adalah gelombang yang memanjang." :
     str.startswith(name, "W5") ? "Panjang W5 = 0.618 × jarak titik 0 sampai ujung W3, ditarik dari ujung W4." :
     str.startswith(name, "A ") ? "Gelombang A menarik balik sebagian seluruh impuls 0–5, diukur dari titik 5." :
     name == "Area W4" ? "Koreksi setelah impuls sering berhenti di sekitar ujung W4 impuls sebelumnya." :
     str.startswith(name, "B ") ? "Gelombang B memantul sebagian dari panjang A, diukur dari ujung A. B < 0.786×A cenderung zigzag, ≥ 0.786×A cenderung flat." :
     str.startswith(name, "C ") ? "Gelombang C diproyeksikan sebagai kelipatan panjang A, ditarik dari ujung B. C = A paling umum; 0.618 dan 1.618 alternatifnya." :
     str.contains(name, "impuls") ? "Retrace dari seluruh impuls 0–5 dihitung dari titik 5 — area yang sering jadi akhir koreksi besar." :
     "Level Fibonacci gelombang yang sedang berjalan."

// Gelombang (hitungan c) tempat sebuah bar berada; dipakai untuk konteks tooltip BOS/CHoCH.
waveFor(Count c, array<int> pb, int bar) =>
    string w = "setelah ujung " + waveName(c.m) + " (titik live)"
    for k = 1 to c.m
        if bar <= pb.get(c.sel.get(k))
            w := waveName(k) + (k == c.m ? " (sedang berjalan)" : "")
            break
    w

// ───────── Rentang chart yang terlihat ─────────
// Dipakai mengubah ukuran teks (piksel) ke satuan harga & bar agar label bisa diatur tidak bertumpuk.
// Konsekuensi: script dihitung ulang setiap chart digeser/di-zoom.
var float visHi   = na
var float visLo   = na
var int   visBars = 0
if time >= chart.left_visible_bar_time and time <= chart.right_visible_bar_time
    visHi   := na(visHi) ? high : math.max(visHi, high)
    visLo   := na(visLo) ? low : math.min(visLo, low)
    visBars += 1

// ───────── Render di bar terakhir ─────────
var labs = array.new<label>()
var lns  = array.new<line>()
tblPos   = tblPosIn == "Kanan atas" ? position.top_right : tblPosIn == "Kiri atas" ? position.top_left : tblPosIn == "Kiri bawah" ? position.bottom_left : position.bottom_right
var bxs  = array.new<box>()
var tbl  = table.new(tblPos, 1, 6, bgcolor = color.new(color.black, 15), border_width = 1, force_overlay = true)
varip string lastKey = ""

if barstate.islast
    for l in labs
        l.delete()
    labs.clear()
    for ln in lns
        ln.delete()
    lns.clear()
    for bx in bxs
        bx.delete()
    bxs.clear()
    table.clear(tbl, 0, 0, 0, 5)

    // Salinan pivot untuk dianalisis. Bila harga sudah berbalik sebagian (provFrac × threshold) dari ekstrem live
    // tapi zigzag belum berbalik penuh, ekstrem berlawanan dipakai sebagai pivot sementara supaya TF besar tidak tertinggal.
    aP = pP.copy()
    aB = pB.copy()
    aT = pT.copy()
    aR = pR.copy()
    bool provisional = false
    if provFrac > 0 and zzDir != 0 and not na(oppExt) and pP.size() > 0
        provisional := zzDir == 1 ? oppExt <= pP.last() * (1 - thr * provFrac) : oppExt >= pP.last() * (1 + thr * provFrac)
    if provisional
        aP.push(oppExt)
        aB.push(oppBar)
        aT.push(-zzDir)
        aR.push(oppRsi)

    int n = aP.size()
    if n >= 5
        // Semua rasio, aturan, dan skor dihitung di cP (log harga bila useLog); aP hanya untuk posisi & tampilan.
        cP = array.new<float>(n, 0.0)
        for i = 0 to n - 1
            cP.set(i, useLog ? math.log(aP.get(i)) : aP.get(i))
        int   start = math.max(0, n - winK)
        float wHi   = cP.get(start)
        float wLo   = cP.get(start)
        float pHi   = aP.get(start)
        float pLo   = aP.get(start)
        for i = start to n - 1
            wHi := math.max(wHi, cP.get(i))
            wLo := math.min(wLo, cP.get(i))
            pHi := math.max(pHi, aP.get(i))
            pLo := math.min(pLo, aP.get(i))

        // Satu kandidat terbaik per (arah, posisi gelombang), jadi best1 dan best2 selalu interpretasi berbeda.
        Count best1 = na
        Count best2 = na
        for sgnI = 0 to 1
            int sgn = sgnI == 0 ? 1 : -1
            for m = 3 to 8
                int expType = sgn * (m % 2 == 1 ? 1 : -1)
                if aT.get(n - 1) == expType and n - start >= m + 1
                    Count cand = searchBest(cP, n - 1, start, m, sgn, wHi - wLo, allowDiag, htfDir, true)
                    if not na(cand)
                        if na(best1) or cand.score > best1.score
                            best2 := best1
                            best1 := cand
                        else if na(best2) or cand.score > best2.score
                            best2 := cand

        // Historis: telusuri pivot terkonfirmasi dari kiri, ambil pola lengkap terbaik di tiap jendela,
        // lalu lanjut dari ujung pola itu supaya pola tidak tumpang tindih.
        string startAlias = ""
        // Pola historis dikumpulkan dulu, digambar setelah hitungan utama/alternatif (lihat akhir blok render).
        histC    = array.new<Count>()
        histSkip = array.new<bool>()
        int hSkipIdx = -1
        if not na(best1)
            hSkipIdx := best1.sel.get(0)
        if showHist
            int liveStart = -1
            if not na(best1)
                liveStart := best1.sel.get(0)
            int hEnd = liveStart >= 0 ? math.min(liveStart, n - 2) : n - 2
            int i    = math.max(0, n - histPivots)
            int prevEnd = -1
            // Pola yang rentang harganya < 2.5% rentang seluruh jendela historis tetap dihitung tapi tidak digambar:
            // di skala linear labelnya menumpuk jadi satu (mis. 2012–2017 di Monthly BTC).
            float hrHi = aP.get(i)
            float hrLo = aP.get(i)
            for t = i to n - 1
                hrHi := math.max(hrHi, aP.get(t))
                hrLo := math.min(hrLo, aP.get(t))
            while i <= hEnd - 5
                int   eMax = math.min(i + histWin, hEnd)
                float hHi  = cP.get(i)
                float hLo  = cP.get(i)
                for t = i to eMax
                    hHi := math.max(hHi, cP.get(t))
                    hLo := math.min(hLo, cP.get(t))
                Count hb = na
                for e = i + 5 to eMax
                    for mi = 0 to 1
                        int m   = mi == 0 ? 5 : 8
                        int sgn = mi == 0 ? aT.get(e) : -aT.get(e)
                        if e - i >= m
                            Count c = searchBest(cP, e, i, m, sgn, hHi - hLo, allowDiag, 0, false)
                            if not na(c) and (na(hb) or c.score > hb.score)
                                hb := c
                if not na(hb) and hb.score >= histMinScore
                    int endIdx = hb.sel.get(hb.m)
                    float sHi = aP.get(hb.sel.get(0))
                    float sLo = sHi
                    for q = 1 to hb.m
                        sHi := math.max(sHi, aP.get(hb.sel.get(q)))
                        sLo := math.min(sLo, aP.get(hb.sel.get(q)))
                    bool drawn = sHi - sLo >= 0.025 * (hrHi - hrLo)
                    if drawn
                        histC.push(hb)
                        histSkip.push(hb.sel.get(0) == prevEnd)
                    if drawn and endIdx == liveStart
                        startAlias := waveName(hb.m)
                    prevEnd := drawn ? endIdx : -1
                    i := endIdx
                else
                    i += 2

        // Batas kiri rentang historis: struktur di luar rentang ini tidak digambar.
        int histLeft = aB.get(math.max(0, n - histPivots))
        if showMS and evBar.size() > 0
            string bosTip = "BOS (break of structure): close menembus swing searah tren struktur → tren berlanjut.\nUji historis (8 dataset crypto): masuk di close saat BOS, stop di swing berlawanan terakhir → target 1R tercapai 53.9% (EV +0.08R), 2R 37.8% (EV +0.13R), n=1.255. Di 1D/1W: 2R 41.9% (EV +0.26R, n=712). Di 4h/1h tidak ada keunggulan."
            string chTip  = "CHoCH (change of character, ≈ MSS): tembus swing pertama yang melawan tren struktur → tanda awal tren berbalik.\nUji historis: target 1R 53.1% (EV +0.06R), 2R 35.6% (EV +0.07R), n=1.259 — belum signifikan."
            string swTip  = "⚡ Didahului sweep likuiditas searah (≤ 20 bar): wick menembus swing lalu close kembali, kemudian struktur berbalik (model ICT sweep → MSS).\nUji historis: target 2R 35.9% (EV +0.08R, n=513); di 1D/1W 39.6% (EV +0.19R ± 0.08, n=316). Kombinasi terbaik kedua setelah BOS 1D/1W; sweep tanpa CHoCH EV ≈ 0R."
            int drawnMS = 0
            for e = evBar.size() - 1 to 0
                int eb = evBar.get(e)
                if eb < histLeft or drawnMS >= msMax
                    break
                drawnMS += 1
                int    ef  = evFrom.get(e)
                float  el  = evLvl.get(e)
                int    ed  = evDir.get(e)
                string et  = evType.get(e)
                bool   wsw = evSwBar.get(e) >= 0
                color  ec  = ed == 1 ? #089981 : #F23645
                lns.push(line.new(ef, el, eb, el, color = color.new(ec, 30), style = line.style_dotted, force_overlay = true))
                string ctx = ""
                if not na(best1)
                    if eb > aB.get(best1.sel.get(0))
                        ctx := "\n\nKonteks Elliott (hitungan utama): terjadi di gelombang " + waveFor(best1, aB, eb) + "."
                labs.push(label.new(math.round((ef + eb) / 2), el, et + (wsw ? " ⚡" : ""), style = ed == 1 ? label.style_label_down : label.style_label_up,
                     color = color.new(ec, 100), textcolor = ec, size = size.tiny,
                     tooltip = (et == "BOS" ? bosTip : chTip) + (wsw ? "\n\n" + swTip : "") + "\nLevel " + str.tostring(el, format.mintick) + ctx, force_overlay = true))
                if wsw
                    // Sweep yang mendahului CHoCH: garis dari swing yang disapu ke bar sweep.
                    lns.push(line.new(evSwFrm.get(e), evSwLvl.get(e), evSwBar.get(e), evSwLvl.get(e), color = color.new(#9C27B0, 20), style = line.style_dotted, force_overlay = true))
                    labs.push(label.new(evSwBar.get(e), evSwLvl.get(e), "sweep", style = ed == 1 ? label.style_label_up : label.style_label_down,
                         color = color.new(#9C27B0, 100), textcolor = #9C27B0, size = size.tiny, tooltip = swTip, force_overlay = true))

        if showSwAll and swBar.size() > 0
            for e = swBar.size() - 1 to 0
                int sb = swBar.get(e)
                if sb < histLeft
                    break
                int sd = swDir.get(e)
                lns.push(line.new(swFrom.get(e), swLvl.get(e), sb, swLvl.get(e), color = color.new(#9C27B0, 60), style = line.style_dotted, force_overlay = true))
                labs.push(label.new(sb, swLvl.get(e), "sw", style = sd == 1 ? label.style_label_up : label.style_label_down,
                     color = color.new(#9C27B0, 100), textcolor = color.new(#9C27B0, 30), size = size.tiny,
                     tooltip = "Sweep likuiditas: wick menembus swing " + str.tostring(swLvl.get(e), format.mintick) + " lalu close kembali.\nUji historis: sweep saja EV −0.08R (1R) / 0.00R (2R), n=2.076; searah tren lebih buruk (−0.08R di 2R). Bermakna hanya bila diikuti CHoCH (⚡).", force_overlay = true))

        if showZz
            for i = start + 1 to n - 1
                lns.push(line.new(aB.get(i - 1), aP.get(i - 1), aB.get(i), aP.get(i), color = color.new(color.gray, 60), width = 1, force_overlay = true))

        // Perkiraan lebar satu karakter dalam bar: ~7 px per karakter pada pane ~1200 px, dengan anggapan candle mengisi
        // pane. Ruang kosong di kanan bar terakhir tidak terbaca (chart.right_visible_bar_time berhenti di bar terakhir);
        // bila ruang itu lebar, lebar teks jadi kekecilan dan label berdekatan bisa sedikit bersinggungan. Perkiraan yang
        // terlalu besar lebih buruk: label tergeser jauh dari pivotnya karena dianggap menimpa label yang sebenarnya jauh.
        float bpc   = math.max(visBars, 20) * 0.006
        if showAlt and not na(best2)
            table.cell(tbl, 0, tblCompact ? 1 : 2, "Alternatif: " + describe(best2, cP), text_color = colAlt, text_size = size.small, text_halign = text.align_left)

        // Registri kotak label gelombang (utama, alternatif, historis) untuk mencegah label saling menimpa.
        lbX1 = array.new<float>()
        lbX2 = array.new<float>()
        lbY1 = array.new<float>()
        lbY2 = array.new<float>()
        float lineHist = (pHi - pLo) * lblGap / 100
        if na(best1)
            table.cell(tbl, 0, 0, "Belum ada hitungan valid di " + str.tostring(winK) + " pivot terakhir", text_color = color.white, text_size = size.small)
        else
            [tp, tn, ip, inm, isd] = computeLevels(best1, cP, useLog)
            string invTxt = ""
            for i = 0 to ip.size() - 1
                invTxt += (i > 0 ? "\n" : "") + "Batal jika " + (isd.get(i) == 1 ? "> " : "< ") + str.tostring(ip.get(i), format.mintick) + " (" + inm.get(i) + ")"
            string mainTxt  = "Utama: " + describe(best1, cP) + (provisional ? " · pivot sementara" : "")
            // Mode ringkas: baris HTF/momentum/S-R dipindah ke tooltip baris utama agar tabel tidak menutupi label.
            string extraTip = ""
            if tblCompact
                table.cell(tbl, 0, 0, mainTxt + "\n" + invTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left)
            else
                table.cell(tbl, 0, 0, mainTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left)
                table.cell(tbl, 0, 1, invTxt, text_color = colInv, text_size = size.small, text_halign = text.align_left)
            if htfTf != "" and useHtf
                string htfTxt = "Swing HTF (" + htfTf + "): " + (htfDir == 1 ? "naik" : htfDir == -1 ? "turun" : "belum terbentuk")
                if tblCompact
                    extraTip += htfTxt + "\n"
                else
                    table.cell(tbl, 0, 3, htfTxt, text_color = color.silver, text_size = size.small, text_halign = text.align_left)

            // Label target/batal/konfirmasi/OB/FVG/S-R ditaruh tepat di kanan bar terakhir (selalu terlihat), garisnya diperpanjang ke kanan.
            // Semua label itu diantre (rq*) lalu disusun di akhir supaya tidak bertumpuk; label proyeksi diantre (pq*) dan
            // hanya digambar bila tidak menabrak label level.
            int labelX = bar_index + 3
            rqY   = array.new<float>()
            rqT   = array.new<string>()
            rqC   = array.new<color>()
            rqTip = array.new<string>()
            pqX   = array.new<int>()
            pqY   = array.new<float>()
            pqT   = array.new<string>()
            pqTip = array.new<string>()
            pqDn  = array.new<bool>()
            float mergeTol = (pHi - pLo) * 0.015
            if projLegs > 0
                [prX, prY, prN, prW] = projectPath(best1, cP, aB, projLegs, bar_index, projTol, useLog)
                int   lx = aB.get(best1.sel.get(best1.m))
                float ly = aP.get(best1.sel.get(best1.m))
                color pc = color.new(colMain, 30)
                for i = 0 to prX.size() - 1
                    int   x = prX.get(i)
                    float y = prY.get(i)
                    if not na(y) and y > 0
                        lns.push(line.new(lx, ly, x, y, color = pc, width = 2, style = line.style_dotted, force_overlay = true))
                        // Ujung gelombang live yang sangat dekat dengan titik live cukup ditunjukkan garisnya, labelnya tidak.
                        if not (i == 0 and math.abs(y - ly) < mergeTol)
                            pqX.push(x)
                            pqY.push(y)
                            pqT.push(prN.get(i) + " " + str.tostring(y, format.mintick))
                            pqTip.push("Proyeksi " + prN.get(i) + " " + str.tostring(y, format.mintick) + "\n" + prW.get(i))
                            pqDn.push(y >= ly)
                        lx := x
                        ly := y

            int   liveIdx = best1.sel.get(best1.m)
            float liveExt = aP.get(liveIdx)
            int   legDir  = aT.get(liveIdx)
            string wv     = waveName(best1.m)

            if showMom
                // Bandingkan ujung gelombang live dengan ujung gelombang searah sebelumnya (m-2).
                int   prevIdx = best1.sel.get(best1.m - 2)
                bool  div     = legDir == 1 ? liveExt > aP.get(prevIdx) and aR.get(liveIdx) < aR.get(prevIdx) : liveExt < aP.get(prevIdx) and aR.get(liveIdx) > aR.get(prevIdx)
                string mt = "Momentum: " + (div ? "divergensi RSI di " + wv + " vs " + waveName(best1.m - 2) : "tanpa divergensi RSI di " + wv)
                if best1.m >= 5
                    float r3 = best1.sgn * (aR.get(best1.sel.get(3)) - 50)
                    float r5 = best1.sgn * (aR.get(best1.sel.get(5)) - 50)
                    mt += " · W3 " + (r3 >= r5 ? "momentum terkuat ✓" : "lebih lemah dari W5 ⚠")
                if tblCompact
                    extraTip += mt + "\n"
                else
                    table.cell(tbl, 0, 4, mt, text_color = color.silver, text_size = size.small, text_halign = text.align_left,
                         tooltip = "Hanya informasi. Uji walk-forward 8 dataset crypto: masuk saat pembalikan setelah W5/C dengan divergensi EV −0.02R (1R) / −0.06R (2R), tanpa divergensi −0.03R / +0.04R — tidak ada keunggulan. W5 dengan W3 bukan momentum terkuat sedikit lebih buruk (−0.10R), belum signifikan.")

            if showConf
                // Gelombang live dianggap selesai saat zigzag berbalik sejauh threshold dari ekstremnya.
                // Dengan pivot sementara, yang belum terkonfirmasi adalah ekstrem zigzag terakhir (n-2). Titik m-1 hitungan bisa
                // pivot yang lebih tua (n-2 lalu jadi swing internal gelombang m), jadi level diambil dari n-2, bukan dari sel(m-1).
                int    cIdx   = provisional ? n - 2 : liveIdx
                float  cExt   = aP.get(cIdx)
                int    cDir   = aT.get(cIdx)
                string cw     = provisional ? (best1.sel.get(best1.m - 1) == n - 2 ? waveName(best1.m - 1) : "swing internal " + wv) : wv
                float  confLv = cDir == 1 ? cExt * (1 - thr) : cExt * (1 + thr)
                int    cx2    = labelX
                lns.push(line.new(aB.get(cIdx), confLv, cx2, confLv, color = color.new(color.teal, 20), style = line.style_dashed, extend = extend.right, force_overlay = true))
                queueRightLabel(confLv, "Konfirmasi " + cw + " selesai jika " + (cDir == 1 ? "< " : "> ") + str.tostring(confLv, format.mintick), color.teal,
                     "Zigzag berbalik di level ini (" + str.tostring(thr * 100, "0.0") + "% dari ekstrem " + str.tostring(cExt, format.mintick) + "), sehingga gelombang " + cw + " ditutup dan hitungan bergerak ke gelombang berikutnya.\nLevel ikut bergeser bila harga membuat ekstrem baru." + (provisional ? "\nSaat ini " + wv + " dihitung dari pivot sementara karena harga sudah berbalik ≥ " + str.tostring(provFrac * 100, "0") + "% threshold." : "") + "\n\nUji historis: masuk tepat saat pembalikan ini, stop di ekstrem, menghasilkan EV ≈ 0R (1R: −0.02R, 2R: +0.05R; n=7.189). Konfirmasi ini bukan sinyal entry.",
                     rqY, rqT, rqC, rqTip)

            string key = str.tostring(best1.sgn) + "|" + str.tostring(best1.m) + "|" + str.tostring(aB.get(best1.sel.get(0)))
            if lastKey != "" and key != lastKey
                alert("EW " + syminfo.ticker + " " + timeframe.period + " — hitungan utama berubah: " + describe(best1, cP), alert.freq_once_per_bar)
            lastKey := key

            if showTargets
                // Level hitungan alternatif dipakai untuk mendeteksi konfluens.
                altLv = array.new<float>()
                if not na(best2)
                    [atp, atn, aip, ainm, aisd] = computeLevels(best2, cP, useLog)
                    altLv := atp.concat(aip)
                int   x1      = aB.get(best1.sel.get(best1.m))
                int   x2      = labelX
                float liveP   = aP.get(best1.sel.get(best1.m))
                int   liveDir = aT.get(best1.sel.get(best1.m))
                for i = 0 to ip.size() - 1
                    float y = ip.get(i)
                    if y > 0
                        lns.push(line.new(x1, y, x2, y, color = colInv, style = line.style_dashed, extend = extend.right, force_overlay = true))
                        queueRightLabel(y, "Batal: " + inm.get(i) + "  " + str.tostring(y, format.mintick), colInv,
                             "Bila harga menembus level ini, hitungan utama melanggar aturan Elliott dan gugur; indikator akan memilih interpretasi lain.",
                             rqY, rqT, rqC, rqTip)
                for i = 0 to tp.size() - 1
                    float y = tp.get(i)
                    // Proyeksi linear gelombang turun yang panjang bisa jatuh di bawah nol; tidak bermakna dan merusak skala.
                    bool passed = liveDir * (liveP - y) >= 0
                    if y > 0 and (showPassed or not passed)
                        bool conf   = false
                        if altLv.size() > 0
                            for a in altLv
                                if math.abs(a - y) / y * 100 <= confTol
                                    conf := true
                                    break
                        color  tc  = passed ? color.new(colTgt, 55) : colTgt
                        string txt = (passed ? "✓ " : "") + tn.get(i) + "  " + str.tostring(y, format.mintick) + (conf ? "  ★" : "")
                        lns.push(line.new(x1, y, x2, y, color = tc, style = line.style_dotted, extend = extend.right, force_overlay = true))
                        string tTip = "Target gelombang " + wv + " (sedang berjalan).\n" + targetExplain(tn.get(i))
                             + (useLog ? "\nRasio dihitung di skala log (persen)." : "")
                             + (passed ? "\n✓ Sudah dilewati harga." : "")
                             + (conf ? "\n★ Berdekatan (≤ " + str.tostring(confTol, "0.0") + "%) dengan level dari hitungan alternatif — dua interpretasi menunjuk area yang sama." : "")
                             + "\n\n" + backtestNote(best1.m)
                        queueRightLabel(y, txt, tc, tTip, rqY, rqT, rqC, rqTip)

            if showOB and obTop.size() > 0
                string obTip = "Order block: candle berlawanan terakhir di awal leg yang menghasilkan BOS/CHoCH, belum tersentuh sejak terbentuk.\nUji historis (8 dataset crypto, n=2.169): retest pertama OB → target 2R 32.3% (EV −0.03R), sama dengan zona acak berukuran sama di leg yang sama (32.6%). Dengan FVG pun tidak berbeda. Konteks, bukan sinyal."
                int nDem = 0
                int nSup = 0
                for j = obTop.size() - 1 to 0
                    if not obMit.get(j)
                        bool dem = obDir.get(j) == 1 and obTop.get(j) < close
                        bool sup = obDir.get(j) == -1 and obBot.get(j) > close
                        if (dem and nDem < obCount) or (sup and nSup < obCount)
                            color oc = dem ? #089981 : #F23645
                            bxs.push(box.new(obLeft.get(j), obTop.get(j), bar_index + 3, obBot.get(j), border_color = color.new(oc, 40), bgcolor = color.new(oc, 85),
                                 border_style = line.style_dashed, extend = extend.right, force_overlay = true))
                            queueRightLabel((obTop.get(j) + obBot.get(j)) / 2, (dem ? "OB demand " : "OB supply ") + str.tostring(obBot.get(j), format.mintick) + "–" + str.tostring(obTop.get(j), format.mintick),
                                 oc, obTip, rqY, rqT, rqC, rqTip)
                            if dem
                                nDem += 1
                            else
                                nSup += 1

            if showFVG and fvTop.size() > 0
                string fvTip = "Fair value gap: celah harga 3 candle (low > high 2 bar sebelumnya, atau sebaliknya) ≥ " + str.tostring(fvgMinAtr, "0.0") + " × ATR, belum tersentuh.\nUji historis (8 dataset crypto): retest pertama FVG ≥ 0.5 ATR → target 2R 33.9% (EV +0.02R, n=2.057) vs zona acak berukuran sama 27.3% (EV −0.18R). FVG lebih dihormati dari level acak, tapi sendirian hanya impas — paling berguna bila searah struktur/target Elliott."
                int nBull = 0
                int nBear = 0
                for j = fvTop.size() - 1 to 0
                    if not fvMit.get(j)
                        bool bu = fvDir.get(j) == 1 and fvTop.get(j) < close
                        bool be = fvDir.get(j) == -1 and fvBot.get(j) > close
                        if (bu and nBull < fvgCount) or (be and nBear < fvgCount)
                            color fc = bu ? #00BCD4 : #E91E63
                            bxs.push(box.new(fvLeft.get(j), fvTop.get(j), bar_index + 3, fvBot.get(j), border_color = color.new(fc, 60), bgcolor = color.new(fc, 88),
                                 extend = extend.right, force_overlay = true))
                            queueRightLabel((fvTop.get(j) + fvBot.get(j)) / 2, (bu ? "FVG bullish " : "FVG bearish ") + str.tostring(fvBot.get(j), format.mintick) + "–" + str.tostring(fvTop.get(j), format.mintick),
                                 fc, fvTip, rqY, rqT, rqC, rqTip)
                            if bu
                                nBull += 1
                            else
                                nBear += 1

            if showSR or showPA
                // Zona dari pivot zigzag terkonfirmasi (tanpa titik live/sementara), dikelompokkan bila jaraknya ≤ srWidth × ATR.
                // zS = swing log terbesar di zona: leg terkecil di antara kiri & kanan pivot (pivot penting bila kedua sisinya besar).
                zLo = array.new<float>()
                zHi = array.new<float>()
                zT  = array.new<int>()
                zB  = array.new<int>()
                zS  = array.new<float>()
                int nConf = pP.size() - 1
                if nConf >= 2
                    pr  = array.new<float>()
                    pbs = array.new<int>()
                    psw = array.new<float>()
                    for k = math.max(0, nConf - 60) to nConf - 1
                        pr.push(pP.get(k))
                        pbs.push(pB.get(k))
                        float legR = math.abs(math.log(pP.get(k + 1) / pP.get(k)))
                        psw.push(k > 0 ? math.min(legR, math.abs(math.log(pP.get(k) / pP.get(k - 1)))) : legR)
                    ord = pr.sort_indices(order.ascending)
                    float w = srWidth * atrV
                    for j = 0 to ord.size() - 1
                        float p  = pr.get(ord.get(j))
                        int   ob = pbs.get(ord.get(j))
                        float sw = psw.get(ord.get(j))
                        if zLo.size() > 0 and p - zLo.last() <= w
                            zHi.set(zHi.size() - 1, p)
                            zT.set(zT.size() - 1, zT.last() + 1)
                            // Kotak dimulai dari sentuhan terakhir, bukan pertama, supaya tidak menutupi chart bertahun-tahun.
                            zB.set(zB.size() - 1, math.max(zB.last(), ob))
                            zS.set(zS.size() - 1, math.max(zS.last(), sw))
                        else
                            zLo.push(p)
                            zHi.push(p)
                            zT.push(1)
                            zB.push(ob)
                            zS.push(sw)
                float majSw = math.log(1 + thr * srMajMult)
                ewLv = tp.copy()
                for v in ip
                    ewLv.push(v)

                if showSR and zLo.size() > 0
                    string srTipZ = "Zona dari pivot zigzag (jumlah sentuhan ×). ★EW = berimpit dengan target/level batal Elliott.\nUji: zona pivot memantul 54.6% vs level acak 55.6% — konteks, bukan sinyal."
                    // Per sisi: zona terdekat sampai srPerSide, ditambah zona Major terdekat bila belum ikut tampil.
                    int  nR   = 0
                    bool majR = false
                    for j = 0 to zLo.size() - 1
                        bool isMaj = zS.get(j) >= majSw or zT.get(j) >= srMajT
                        bool okZ   = zT.get(j) >= srMinT or isMaj
                        string cTip = srClassTip(zS.get(j), zT.get(j), majSw, srMajT, isMaj) + "\n\n" + srTipZ
                        if okZ and zLo.get(j) <= close and zHi.get(j) >= close
                            string zt = drawSRZone(zLo.get(j), zHi.get(j), zT.get(j), zB.get(j), "Zona", isMaj, ewLv, atrV, bxs)
                            queueRightLabel((zLo.get(j) + zHi.get(j)) / 2, zt, isMaj ? color.gray : color.new(color.gray, 35), cTip, rqY, rqT, rqC, rqTip)
                        else if okZ and zLo.get(j) > close and (nR < srPerSide or (isMaj and not majR))
                            string zt = drawSRZone(zLo.get(j), zHi.get(j), zT.get(j), zB.get(j), "R", isMaj, ewLv, atrV, bxs)
                            queueRightLabel((zLo.get(j) + zHi.get(j)) / 2, zt, isMaj ? #F23645 : color.new(#F23645, 35), cTip, rqY, rqT, rqC, rqTip)
                            nR += 1
                            majR := majR or isMaj
                    int  nS   = 0
                    bool majS = false
                    for j = zLo.size() - 1 to 0
                        bool isMaj = zS.get(j) >= majSw or zT.get(j) >= srMajT
                        bool okZ   = zT.get(j) >= srMinT or isMaj
                        if okZ and zHi.get(j) < close and (nS < srPerSide or (isMaj and not majS))
                            string cTip = srClassTip(zS.get(j), zT.get(j), majSw, srMajT, isMaj) + "\n\n" + srTipZ
                            string zt = drawSRZone(zLo.get(j), zHi.get(j), zT.get(j), zB.get(j), "S", isMaj, ewLv, atrV, bxs)
                            queueRightLabel((zLo.get(j) + zHi.get(j)) / 2, zt, isMaj ? #089981 : color.new(#089981, 35), cTip, rqY, rqT, rqC, rqTip)
                            nS += 1
                            majS := majS or isMaj

                if showPA
                    // Bar pivot yang sudah berlabel gelombang (utama/alternatif): tanda PA di sana akan menimpa labelnya.
                    lblBars = array.new<int>()
                    for q = 0 to best1.m
                        lblBars.push(aB.get(best1.sel.get(q)))
                    if not na(best2)
                        for q = 0 to best2.m
                            lblBars.push(aB.get(best2.sel.get(q)))
                    for k = 1 to paBars
                        float o  = open[k]
                        float h  = high[k]
                        float l  = low[k]
                        float c  = close[k]
                        float po = open[k + 1]
                        float pc = close[k + 1]
                        float rng  = h - l
                        float body = math.abs(c - o)
                        if rng > 0
                            bool bullEng = c > o and pc < po and c >= po and o <= pc
                            bool bullPin = math.min(o, c) - l >= 2 * body and math.min(o, c) - l >= 0.6 * rng and c - l >= 0.6 * rng
                            bool bearEng = c < o and pc > po and c <= po and o >= pc
                            bool bearPin = h - math.max(o, c) >= 2 * body and h - math.max(o, c) >= 0.6 * rng and h - c >= 0.6 * rng
                            bool bull = bullEng or bullPin
                            bool bear = bearEng or bearPin
                            bool onLabel = false
                            for lbBar in lblBars
                                if math.abs(bar_index - k - lbBar) <= 1
                                    onLabel := true
                                    break
                            if bull != bear and not onLabel
                                float  ext   = bull ? l : h
                                string where = ""
                                if zLo.size() > 0
                                    for j = 0 to zLo.size() - 1
                                        // Sama dengan syarat tampil zona: Minor ≥ srMinT sentuhan, Major walau 1 sentuhan.
                                        bool zMaj = zS.get(j) >= majSw or zT.get(j) >= srMajT
                                        if (zT.get(j) >= srMinT or zMaj) and ext >= zLo.get(j) - 0.25 * atrV and ext <= zHi.get(j) + 0.25 * atrV
                                            where := (zMaj ? "zona Major " : "zona Minor ") + str.tostring((zLo.get(j) + zHi.get(j)) / 2, format.mintick) + " (" + str.tostring(zT.get(j)) + "× sentuhan)"
                                            break
                                if where == ""
                                    for v in ewLv
                                        if math.abs(ext - v) <= 0.5 * atrV
                                            where := "level Elliott " + str.tostring(v, format.mintick)
                                            break
                                if where != ""
                                    string nm = bull ? (bullEng ? "Bullish engulfing" : "Hammer / pin bar bullish") : (bearEng ? "Bearish engulfing" : "Shooting star / pin bar bearish")
                                    labs.push(label.new(bar_index - k, ext, bull ? "▲" : "▼", style = bull ? label.style_label_up : label.style_label_down,
                                         color = color.new(color.white, 100), textcolor = bull ? #089981 : #F23645, size = size.small,
                                         tooltip = nm + " di " + where + "\n\nUji historis (8 dataset crypto, n=11.084): masuk di close bar PA dengan stop di ujung bar menghasilkan EV −0.02R (target 1R) / +0.05R (target 2R); PA di zona pivot tidak berbeda dari PA di level acak. Pakai sebagai konteks, bukan sinyal.", force_overlay = true))

                string srTip = "Uji walk-forward 8 dataset crypto: sentuhan zona pivot memantul 54.6% vs level acak 55.6% (n≈4.000) — zona tidak lebih kuat dari level acak. Price action: EV ≈ 0R. Ditampilkan seminimal mungkin sebagai konteks; level yang berimpit dengan Elliott (★EW) paling layak diperhatikan."
                if tblCompact
                    extraTip += "S/R & PA: " + srTip + "\n"
                else
                    table.cell(tbl, 0, 5, "S/R: Major (swing ≥ " + str.tostring(srMajMult, "0.##") + "× threshold atau ≥" + str.tostring(srMajT) + "× sentuhan) · Minor ≥" + str.tostring(srMinT) + "× sentuhan · PA hanya di zona/level Elliott", text_color = color.silver, text_size = size.small, text_halign = text.align_left, tooltip = srTip)

            // Tinggi satu baris label dalam harga = persen dari rentang candle yang terlihat. Tepat bila skala harga chart
            // "Auto" + "Skalakan chart harga saja" (skala mengikuti candle, bukan kotak/label yang jauh). Pada skala manual
            // rentang layar tidak bisa dibaca script; sesuaikan lewat input lblGap.
            float lineH = na(visHi) ? (pHi - pLo) * lblGap / 100 : (visHi - visLo) * lblGap / 100
            lineHist := lineH

            // Hitungan utama digambar dulu supaya label alternatif/historis yang menimpanya bisa dilewati.
            float lblOver = drawCount(best1, showAlt ? best2 : na, startAlias, aP, cP, aB, aT, colMain, true, bpc, lineH, lbX1, lbX2, lbY1, lbY2, labs, lns)
            if showAlt and not na(best2)
                lblOver := math.max(lblOver, drawCount(best2, best1, "", aP, cP, aB, aT, colAlt, false, bpc, lineH, lbX1, lbX2, lbY1, lbY2, labs, lns))
            // Label level kanan dimulai setelah ujung kanan label gelombang yang paling dekat bar terakhir.
            int labelXR = labelX + math.min(math.max(0, int(math.ceil(lblOver))), 400)   // batas 500 bar ke depan

            placedY = layoutRightLabels(rqY, rqT, rqC, rqTip, labelXR, lineH, close, labs)
            // Label proyeksi (teks di tengah titik, di atas untuk label_down / di bawah untuk label_up) yang sebaris dengan label
            // level di kanan digeser menjauhi titiknya, maksimal 4 baris; label tetap ditulis. Cek horizontal tidak dipakai: lebar
            // ruang kosong di kanan bar terakhir tidak bisa dibaca script (chart.right_visible_bar_time berhenti di bar terakhir).
            if pqX.size() > 0
                color pc2 = color.new(colMain, 30)
                for i = 0 to pqX.size() - 1
                    float py   = pqY.get(i)
                    float pBot = pqDn.get(i) ? py : py - lineH
                    if placedY.size() > 0
                        for tries = 0 to 3
                            bool hit = false
                            for j = 0 to placedY.size() - 1
                                float ry = placedY.get(j)
                                if pBot < ry + lineH and ry < pBot + lineH
                                    hit := true
                                    break
                            if not hit
                                break
                            float d = pqDn.get(i) ? lineH : -lineH
                            pBot += d
                            py   += d
                    labs.push(label.new(pqX.get(i), py, pqT.get(i), style = pqDn.get(i) ? label.style_label_down : label.style_label_up,
                         color = color.new(colMain, 100), textcolor = pc2, size = size.small, tooltip = pqTip.get(i), force_overlay = true))

            if tblCompact
                table.cell(tbl, 0, 0, mainTxt + "\n" + invTxt, text_color = color.white, text_size = size.small, text_halign = text.align_left,
                     tooltip = extraTip == "" ? "Arahkan kursor ke label di chart untuk detail tiap titik." : extraTip)

        if histC.size() > 0
            for h = 0 to histC.size() - 1
                drawHist(histC.get(h), aP, cP, aB, aT, colHist, histSkip.get(h), hSkipIdx, bpc, lineHist, lbX1, lbX2, lbY1, lbY2, labs, lns)
